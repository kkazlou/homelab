#!/bin/sh
# Managed by Ansible. Sends a command to the UNAS over restricted SSH as the nut user.
# Usage: nut-unas check|poweroff [attempts]

cmd="$1"
attempts="${2:-1}"
case "$cmd" in
    check|poweroff) ;;
    *) echo "usage: $0 check|poweroff [attempts]" >&2; exit 2 ;;
esac

# upsmon runs SHUTDOWNCMD as root; the key belongs to nut.
if [ "$(id -u)" -eq 0 ]; then
    exec runuser -u nut -- "$0" "$@"
fi

i=1
while :; do
    out=$(timeout 30 ssh -T -F /dev/null \
        -i {{ nut_unas_ssh_key }} -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 \
        -o StrictHostKeyChecking=yes -o UserKnownHostsFile={{ nut_unas_known_hosts }} \
        -o GlobalKnownHostsFile=/dev/null \
        {{ nut_unas_user }}@{{ nut_unas_host }} "$cmd" </dev/null 2>&1)
    rc=$?
    if [ "$rc" -eq 0 ]; then
        logger -t nut-unas "$cmd succeeded (attempt $i/$attempts): $out"
        echo "$out"
        exit 0
    fi
    logger -t nut-unas "$cmd failed (attempt $i/$attempts, rc=$rc): $out"
    if [ "$i" -ge "$attempts" ]; then
        echo "$out" >&2
        exit "$rc"
    fi
    i=$((i + 1))
    sleep 10
done
